[package]
name = "yukti"
version = "${file:VERSION}"
description = "Device abstraction — USB, optical, block, GPU, network, udev hotplug, mount/eject"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/yukti"
language = "cyrius"
cyrius = "6.6.18"

[build]
entry = "src/main.cyr"
output = "build/yukti"

# `[lib]` exists so `cyrius distlib` knows what to concatenate into
# dist/yukti.cyr. Don't move `modules` into `[build]` — it makes
# `cyrius build` prepend them before src/main.cyr, which then
# re-includes them via src/lib.cyr and inflates the binary by ~38%.
#
# Multi-dist profiles (Cyrius 5.4.6+):
#   cyrius distlib         → dist/yukti.cyr      (default [lib], full userland)
#   cyrius distlib core    → dist/yukti-core.cyr ([lib.core], kernel-safe)
#
# The `core` profile is the bare-metal subset consumable by the AGNOS
# kernel: pure enums, struct layouts, PCI class/vendor tables. No
# alloc, no syscalls, no stdlib. See programs/core_smoke.cyr for the
# invariant check.
[lib]
modules = [
    "src/syscalls.cyr",
    "src/error.cyr",
    "src/core.cyr",
    "src/pci.cyr",
    "src/device.cyr",
    "src/event.cyr",
    "src/storage.cyr",
    "src/optical.cyr",
    "src/udev.cyr",
    "src/linux.cyr",
    "src/udev_rules.cyr",
    "src/partition.cyr",
    "src/device_db.cyr",
    "src/network.cyr",
    "src/gpu.cyr",
    "src/audio.cyr",
]

[lib.core]
modules = [
    "src/core.cyr",
    "src/pci.cyr",
]

[deps]
stdlib = [
    "syscalls",
    "string",
    "alloc",
    "str",
    "fmt",
    "vec",
    "hashmap",
    "io",
    "fs",
    "tagged",
    "process",
    "fnptr",
    "chrono",
    "args",
    "freelist",
    "atomic",
    "sync",
    "thread_local",
]

[deps.sakshi]
git = "https://github.com/MacCracken/sakshi.git"
tag = "2.5.6"
modules = ["dist/sakshi.cyr"]

# patra backs device_db (the persistent device-history store) ONLY. It pulls
# stdlib atomic/sync/thread_local, declared in [deps].stdlib above because the
# cyrius 6.4.x strict transitive-dep check requires them named. patra also
# claims its thread-local slots through cyrius's slot allocator,
# thread_local_alloc, which needs cyrius >= 6.4.65; the 6.6.18 pin satisfies it.
#
# The tag does not outrun the bundle. It stays for `target = "linux"`, which the
# bundled lib has no way to express. agnos has no device-history DB, so patra is
# fetched on Linux only, and `src/lib.cyr` #ifndef-gates both the include and
# `device_db.cyr` off on agnos to match.
#
# Keep BOTH tags (sakshi above, patra here) in lockstep with the versions the
# pinned cyrius bundles: 6.6.18 folds sakshi 2.5.6 and patra 1.15.1. A newer
# local tag is folded into the NEXT cyrius release; pinning ahead of the fold
# breaks in both directions, as measured at the 2.3.12 bump:
#   - patra ahead: `cyrius build` warns that ./lib/ shadows the version-pinned
#     lib.
#   - sakshi ahead: patra's dep sidecar names `sakshi` as a stdlib leaf, so
#     `cyrius deps` silently overwrites the git dep with the bundled copy while
#     cyrius.lock still records the newer tag's commit.
[deps.patra]
git = "https://github.com/MacCracken/patra.git"
tag = "1.15.1"
modules = ["dist/patra.cyr"]
target = "linux"
