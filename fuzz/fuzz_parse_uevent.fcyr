# Fuzz target: parse_uevent
# Feeds random byte sequences to the uevent parser to test robustness.
# The parser must not crash on any input.

include "src/lib.cyr"

fn fuzz_one(buf, len) {
    # parse_uevent should gracefully handle any byte sequence
    var result = parse_uevent(buf, len);
    # If it parsed successfully, validate the result is usable
    if (result != 0) {
        var action = ue_action(result);
        var sys_path = ue_sys_path(result);
        var subsystem = ue_subsystem(result);
        # Access properties without crashing
        var props = ue_properties(result);
        # Try to classify the event
        classify_device(result);
    }
    return 0;
}

# Build a realistic multi-property uevent into `buf`, returning its true
# byte length INCLUDING the interior NUL separators. Written byte-wise
# because any strlen-based construction silently stops at the first NUL —
# which is the bug this harness had.
fn _uev_put(buf, off, cstr) {
    var n = strlen(cstr);
    memcpy(buf + off, cstr, n);
    return off + n;
}

fn _build_uevent(buf) {
    var off = 0;
    off = _uev_put(buf, off, "add@/devices/pci0000:00/usb1/block/sdb");
    store8(buf + off, 0); off = off + 1;
    off = _uev_put(buf, off, "ACTION=add");
    store8(buf + off, 0); off = off + 1;
    off = _uev_put(buf, off, "DEVPATH=/devices/pci0000:00/usb1/block/sdb");
    store8(buf + off, 0); off = off + 1;
    off = _uev_put(buf, off, "SUBSYSTEM=block");
    store8(buf + off, 0); off = off + 1;
    off = _uev_put(buf, off, "DEVTYPE=disk");
    store8(buf + off, 0); off = off + 1;
    off = _uev_put(buf, off, "DEVNAME=sdb");
    store8(buf + off, 0); off = off + 1;
    off = _uev_put(buf, off, "ID_SERIAL_SHORT=SN12345");
    store8(buf + off, 0); off = off + 1;
    off = _uev_put(buf, off, "SEQNUM=4242");
    store8(buf + off, 0); off = off + 1;
    return off;
}

fn main() {
    alloc_init();

    # Test with known-good input. strlen() stops at the first \0 byte,
    # so only the header segment below actually reaches parse_uevent.
    # The other segments (ACTION=, DEVPATH=, etc.) are covered by
    # parser-level tests in tcyr.
    var good = "add@/devices/pci/usb/block/sdb";
    fuzz_one(good, strlen(good));

    # Test with empty input
    fuzz_one("", 0);

    # Test with just nulls
    var nulls[16];
    store64(&nulls, 0);
    store64(&nulls + 8, 0);
    fuzz_one(&nulls, 16);

    # Test with no action@devpath header
    var noheader = "ACTION=add\0DEVPATH=/block/sda\0SUBSYSTEM=block\0";
    fuzz_one(noheader, strlen(noheader));

    # Test with garbage bytes
    var garbage = "asdfjkl;asdfjkl;qwerty\0\0\0zxcvbnm";
    fuzz_one(garbage, 32);

    # Test with only header, no key=value
    var headeronly = "add@/devices/pci\0";
    fuzz_one(headeronly, strlen(headeronly));

    # Test with malformed key=value (no =)
    var noequals = "add@/dev\0NOSEPARATOR\0SUBSYSTEM=block\0";
    fuzz_one(noequals, strlen(noequals));

    # Test with very long values
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "add@/dev/sda\0DEVPATH=");
    for (var i = 0; i < 200; i = i + 1) {
        str_builder_add_cstr(sb, "AAAA");
    }
    str_builder_add_cstr(sb, "\0SUBSYSTEM=block\0");
    var long_val = str_builder_build(sb);
    fuzz_one(str_data(long_val), str_len(long_val));

    # Random mutation fuzzing.
    #
    # 2.3.5: this used `var baselen = strlen(base)` on a header-only
    # string, and the harness's own comment admitted the consequence —
    # strlen stops at the first NUL, so the mutator only ever flipped
    # bytes in the `add@/devices/...` HEADER and the truncation loop only
    # ever cut inside it. The NUL-separated KEY=VALUE properties, which
    # are the actual parsing surface (_parse_uevent_key, the ACTION /
    # DEVPATH / SUBSYSTEM extraction, and every consumer of them) were
    # never mutated at all.
    #
    # Build the payload byte-wise with an EXPLICIT length so the NULs are
    # part of the fuzzed region.
    var mutbuf[512];
    var baselen = _build_uevent(&mutbuf);

    for (var round = 0; round < 4000; round = round + 1) {
        # Flip one byte anywhere in the payload, NULs included — a
        # corrupted separator is exactly the case that used to be
        # unreachable.
        var pos = (round * 7 + 13) % baselen;
        var orig = load8(&mutbuf + pos);
        store8(&mutbuf + pos, (orig + round) & 0xFF);

        fuzz_one(&mutbuf, baselen);

        # Restore
        store8(&mutbuf + pos, orig);
    }

    # Two-byte mutations — catches separator damage that a single flip
    # cannot produce (e.g. losing both the '=' and the terminating NUL).
    for (var r2 = 0; r2 < 2000; r2 = r2 + 1) {
        var p1 = (r2 * 11 + 3) % baselen;
        var p2 = (r2 * 5 + 29) % baselen;
        var o1 = load8(&mutbuf + p1);
        var o2 = load8(&mutbuf + p2);
        store8(&mutbuf + p1, (o1 + r2) & 0xFF);
        store8(&mutbuf + p2, (o2 + r2 * 3) & 0xFF);
        fuzz_one(&mutbuf, baselen);
        store8(&mutbuf + p1, o1);
        store8(&mutbuf + p2, o2);
    }

    # Truncation fuzzing across the WHOLE payload, not just the header.
    # A cut mid-property leaves a key with no '=' or a value with no NUL.
    for (var tlen = 0; tlen < baselen; tlen = tlen + 1) {
        fuzz_one(&mutbuf, tlen);
    }

    sys_write(1, "fuzz_parse_uevent: passed\n", 26);
    sys_exit(0);
}

main();
