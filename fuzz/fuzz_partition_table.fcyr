# Fuzz target: read_partition_table (MBR + GPT parsers)
#
# Audit 2026-04-19 flagged the GPT parser as a coverage gap. This
# target writes fuzz-generated bytes to a temp file and runs the
# real entry point, which exercises both MBR and GPT paths. Key
# invariants:
#   - parser must not crash on any input
#   - malicious GPT entry_size > 128 must be rejected (HIGH-2 fix)
#   - MBR signature mismatch returns PT_NONE, not a crash
#
# Build:  cyrius build fuzz/fuzz_partition_table.fcyr build/fuzz_partition_table
# Run:    ./build/fuzz_partition_table ; echo exit=$?

include "src/lib.cyr"

var _tmp_path = "/tmp/yukti_fuzz_pt";

# Open /tmp/yukti_fuzz_pt for write, truncating. O_WRONLY|O_CREAT|O_TRUNC = 1|64|512 = 577.
# xopen supplies mode 0o644 itself, which is what the old raw call passed as 420.
# 2.3.2: was syscall(2/1/3, …) — raw x86_64 open/write/close.
fn _write_fixture(buf, n) {
    var fd = xopen(_tmp_path, 577);
    if (fd < 0) { return fd; }
    var w = sys_write(fd, buf, n);
    sys_close(fd);
    if (w != n) { return 0 - 1; }   # short write => fixture is not what the caller asked for
    return 0;
}

# Fail loudly with a distinct exit code so a CI failure names the broken
# invariant instead of just "crashed".
fn _inv(cond, msg, code) {
    if (cond == 0) {
        sys_write(2, "INVARIANT VIOLATED: ", 20);
        sys_write(2, msg, strlen(msg));
        sys_write(2, "\n", 1);
        sys_exit(code);
    }
    return 0;
}

fn fuzz_one(buf, n) {
    _write_fixture(buf, n);
    var r = read_partition_table(_tmp_path);
    # Either is_ok → Result(pt) or Err — both are valid outcomes for
    # arbitrary bytes. What is NOT valid is an Ok carrying a table that
    # violates its own contract.
    #
    # 2.3.5: this used to call the accessors and assert NOTHING, so the
    # harness only proved "does not segfault". A hostile GPT that yielded
    # a negative size, an out-of-range index, or a bogus table type passed
    # cleanly. Every check below must hold for EVERY input, valid or not.
    if (is_ok(r)) {
        var pt = payload(r);
        var t = pt_type(pt);
        _inv(t >= PT_NONE, "pt_type below PT_NONE", 20);
        _inv(t <= PT_GPT, "pt_type above PT_GPT", 21);

        var entries = pt_entries(pt);
        _inv(entries != 0, "pt_entries is null on an Ok table", 22);
        var count = vec_len(entries);
        _inv(count >= 0, "negative entry count", 23);
        # A GPT header may claim a huge entry count; the parser must bound
        # what it actually materialises.
        _inv(count <= 1024, "entry count implausibly large (unbounded parse?)", 24);
        # PT_NONE must carry no entries.
        if (t == PT_NONE) {
            _inv(count == 0, "PT_NONE with entries", 25);
        }

        for (var i = 0; i < count; i = i + 1) {
            var pe = vec_get(entries, i);
            _inv(pe != 0, "null entry in the entries vec", 26);

            _inv(pe_index(pe) >= 0, "negative partition index", 27);
            _inv(pe_index(pe) < 1024, "partition index implausibly large", 28);

            # A start LBA read from disk is untrusted; it must never come
            # back negative after parsing (which would mean a wrapped or
            # sign-extended read).
            _inv(pe_start_lba(pe) >= 0, "negative start_lba", 29);
            _inv(pe_size_sectors(pe) >= 0, "negative size_sectors", 30);
            _inv(pe_size_bytes(pe) >= 0, "negative size_bytes", 31);

            # size_bytes must be the sector count scaled by 512, and that
            # multiply must not have wrapped i64.
            if (pe_size_sectors(pe) > 0) {
                _inv(pe_size_bytes(pe) >= pe_size_sectors(pe),
                  "size_bytes < size_sectors (multiply wrapped?)", 32);
            }

            # Booleans must be booleans.
            var b = pe_bootable(pe);
            var b_ok = 0;
            if (b == 0) { b_ok = 1; }
            if (b == 1) { b_ok = 1; }
            _inv(b_ok, "bootable is not 0/1", 33);
            var e = pe_is_efi(pe);
            var e_ok = 0;
            if (e == 0) { e_ok = 1; }
            if (e == 1) { e_ok = 1; }
            _inv(e_ok, "is_efi is not 0/1", 34);

            # A name, when present, must be a readable Str of sane length.
            var nm = pe_name(pe);
            if (nm != 0) {
                _inv(str_len(nm) >= 0, "negative name length", 35);
                _inv(str_len(nm) <= 512, "name length implausibly large", 36);
            }
        }
    }
    return 0;
}

fn main() {
    alloc_init();

    # Empty / tiny (below sector)
    var tiny[4];
    store8(&tiny, 0);
    fuzz_one(&tiny, 0);
    fuzz_one(&tiny, 4);

    # 512-byte buffer: no MBR signature => PT_NONE
    var blank[512];
    for (var i = 0; i < 512; i = i + 1) { store8(&blank + i, 0); }
    fuzz_one(&blank, 512);

    # Valid MBR signature, one Linux partition at LBA 2048
    var mbr[512];
    for (var i = 0; i < 512; i = i + 1) { store8(&mbr + i, 0); }
    # Partition entry at offset 446: status=0x80, type=0x83, LBA=2048, count=204800
    store8(&mbr + 446, 0x80);
    store8(&mbr + 446 + 4, 0x83);
    store8(&mbr + 446 + 8, 0x00);  store8(&mbr + 446 + 9, 0x08);
    store8(&mbr + 446 + 10, 0x00); store8(&mbr + 446 + 11, 0x00);
    store8(&mbr + 446 + 12, 0x00); store8(&mbr + 446 + 13, 0x20);
    store8(&mbr + 446 + 14, 0x03); store8(&mbr + 446 + 15, 0x00);
    # Signature 0x55 0xAA
    store8(&mbr + 510, 0x55);
    store8(&mbr + 511, 0xAA);
    fuzz_one(&mbr, 512);

    # Protective MBR (type 0xEE) + crafted GPT header at LBA 1
    var pgpt[1024];
    for (var i = 0; i < 1024; i = i + 1) { store8(&pgpt + i, 0); }
    # MBR signature
    store8(&pgpt + 510, 0x55);
    store8(&pgpt + 511, 0xAA);
    # Protective MBR entry: type 0xEE
    store8(&pgpt + 446 + 4, 0xEE);
    # GPT header at LBA 1 (offset 512): "EFI PART"
    store8(&pgpt + 512 + 0, 0x45);  # 'E'
    store8(&pgpt + 512 + 1, 0x46);  # 'F'
    store8(&pgpt + 512 + 2, 0x49);  # 'I'
    store8(&pgpt + 512 + 3, 0x20);  # ' '
    store8(&pgpt + 512 + 4, 0x50);  # 'P'
    store8(&pgpt + 512 + 5, 0x41);  # 'A'
    store8(&pgpt + 512 + 6, 0x52);  # 'R'
    store8(&pgpt + 512 + 7, 0x54);  # 'T'
    # num_entries = 0 at offset 80, entry_size = 128 at offset 84
    store8(&pgpt + 512 + 84, 128);
    fuzz_one(&pgpt, 1024);

    # AUDIT HIGH-2: entry_size > 128 MUST be rejected. Mutate the
    # in-memory buffer AND re-write the file, then call the parser.
    # entry_size = 0x0400 (1024) is the malicious value; the parser
    # must not read 1024 bytes into its 128-byte stack buffer.
    store8(&pgpt + 512 + 84, 0x00);
    store8(&pgpt + 512 + 85, 0x04);   # 1024 little-endian
    store8(&pgpt + 512 + 80, 1);      # num_entries = 1
    _write_fixture(&pgpt, 1024);
    var r_bad = read_partition_table(_tmp_path);
    if (is_ok(r_bad)) {
        sys_write(2, "FUZZ FAIL: GPT entry_size > 128 accepted\n", 41);
        sys_exit(1);
    }
    # Restore valid entry_size for subsequent mutation fuzzing
    store8(&pgpt + 512 + 84, 128);
    store8(&pgpt + 512 + 85, 0);
    store8(&pgpt + 512 + 80, 0);
    _write_fixture(&pgpt, 1024);

    # ---------------------------------------------------------------
    # Hostile LBA fields (2.3.8)
    #
    # Every LBA in a GPT comes off the disk and the threat model names a
    # hostile disk explicitly. Until 2.3.8 they were used raw:
    #   * entry_start_lba * SECTOR_SIZE overflows i64 and wraps to a
    #     negative or aliased seek target
    #   * end_lba < start_lba makes `end - start + 1` NEGATIVE
    #   * a u64 above 2^63 reads as a negative i64
    #   * a huge span overflows `sector_count * SECTOR_SIZE`
    #
    # These fixtures drive each case through the real entry point. The
    # invariants in fuzz_one do the asserting — no negative index, LBA,
    # sector count or byte size may ever escape, and size_bytes must not be
    # smaller than size_sectors (a wrapped multiply).
    #
    # A build without the range checks exits 29/30/31/32 here.
    var gh = 512;   # GPT header offset

    # 1. entry_start_lba = 2^56 — overflows when scaled by 512
    store8(&pgpt + gh + 80, 1);       # num_entries = 1
    for (var b = 0; b < 8; b = b + 1) { store8(&pgpt + gh + 72 + b, 0); }
    store8(&pgpt + gh + 72 + 7, 0x01);
    fuzz_one(&pgpt, 1024);

    # 2. entry_start_lba = 0xFFFFFFFFFFFFFFFF (reads as -1)
    for (var b = 0; b < 8; b = b + 1) { store8(&pgpt + gh + 72 + b, 0xFF); }
    fuzz_one(&pgpt, 1024);

    # Put the entry array back at LBA 2 so the entries below are reachable.
    for (var b = 0; b < 8; b = b + 1) { store8(&pgpt + gh + 72 + b, 0); }
    store8(&pgpt + gh + 72, 2);

    # A non-zero type GUID so the entry is not skipped as empty.
    var ent = 1024;   # LBA 2
    for (var b = 0; b < 16; b = b + 1) { store8(&pgpt + ent + b, 0x5A); }

    # 3. end_lba < start_lba  -> negative sector count
    for (var b = 0; b < 16; b = b + 1) { store8(&pgpt + ent + 32 + b, 0); }
    store8(&pgpt + ent + 32, 200);    # start_lba = 200
    store8(&pgpt + ent + 40, 100);    # end_lba   = 100
    fuzz_one(&pgpt, 1152);

    # 4. start_lba = 2^63 (negative as i64)
    for (var b = 0; b < 16; b = b + 1) { store8(&pgpt + ent + 32 + b, 0); }
    store8(&pgpt + ent + 32 + 7, 0x80);
    store8(&pgpt + ent + 40 + 7, 0x80);
    fuzz_one(&pgpt, 1152);

    # 5. huge but "positive" span -> sector_count * 512 overflows
    for (var b = 0; b < 16; b = b + 1) { store8(&pgpt + ent + 32 + b, 0); }
    store8(&pgpt + ent + 40 + 6, 0x40);   # end_lba ~ 2^54, start 0
    fuzz_one(&pgpt, 1152);

    # 6. both LBAs at the i64 max nibble
    for (var b = 0; b < 8; b = b + 1) { store8(&pgpt + ent + 32 + b, 0xFF); }
    for (var b = 0; b < 8; b = b + 1) { store8(&pgpt + ent + 40 + b, 0xFF); }
    store8(&pgpt + ent + 32 + 7, 0x7F);
    store8(&pgpt + ent + 40 + 7, 0x7F);
    fuzz_one(&pgpt, 1152);

    # Restore a sane entry for the mutation pass below.
    for (var b = 0; b < 16; b = b + 1) { store8(&pgpt + ent + 32 + b, 0); }
    store8(&pgpt + ent + 32, 34);
    store8(&pgpt + ent + 40, 100);
    store8(&pgpt + gh + 80, 0);

    # Random mutation fuzzing on the GPT-header sector
    var mutbuf[1024];
    memcpy(&mutbuf, &pgpt, 1024);
    for (var round = 0; round < 500; round = round + 1) {
        var pos = (round * 13 + 17) % 1024;
        var orig = load8(&mutbuf + pos);
        store8(&mutbuf + pos, (orig + round * 7) & 0xFF);
        fuzz_one(&mutbuf, 1024);
        store8(&mutbuf + pos, orig);
    }

    # Truncation fuzzing — truncate to every length 0..1024
    for (var tlen = 0; tlen < 1024; tlen = tlen + 17) {
        fuzz_one(&pgpt, tlen);
    }

    # Cleanup fixture. 2.3.2: was syscall(87, …) — raw x86_64 unlink, which is
    # NOT in the backend's ESYSXLAT whitelist, so on aarch64 it silently failed
    # and left the fixture behind.
    xunlink(_tmp_path);

    sys_write(1, "fuzz_partition_table: passed\n", 29);
    sys_exit(0);
}

main();
