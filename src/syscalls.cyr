# yukti/syscalls.cyr — agnos ABI bridges, and the one syscall the stdlib
# does not wrap.
#
# Every kernel call in yukti goes through a stdlib wrapper: the `sys_*`
# family in lib/syscalls*.cyr or the portable `x*` family in lib/io.cyr.
# Those resolve the syscall number per target at compile time. yukti
# declares no `SYS_*` number of its own, apart from the x86_64 ppoll
# below, which no stdlib peer declares.
#
# 2.3.12 (cyrius 6.6.6) removed the arch-conditional `enum YkSyscalls`
# blocks that used to sit here. They hand-carried numbers the stdlib
# had not named yet, and one of them was wrong: the aarch64 statfs
# entry held 43, aarch64's native statfs number, but cycc reads a
# syscall number as an x86 number and renumbers it through ESYSXLAT.
# ESYSXLAT's x86-compat `accept 43 -> 202` row turned it into
# accept(2). So `filesystem_usage` failed with "statfs failed:
# errno 14" on every ARM host from cyrius 6.2.10 until this release.
# Traced under `qemu-aarch64 -strace` as `accept(<path>, <buf>, …) =
# -1 errno=14`. 6.6.6 names statfs in both Linux peers (x86 137,
# renumbered 137 -> 43 on aarch64), and the socket family, ioctl,
# lseek and newfstatat already had names. So the local numbers could
# only ever shadow the stdlib's, and 6.6.6 warns that they do.
#
# The agnos half: agnos IS an x86_64 target, so cycc defines
# CYRIUS_ARCH_X86 *and* CYRIUS_TARGET_AGNOS on an agnos build. The
# agnos peer (lib/syscalls_x86_64_agnos.cyr) is standalone. It does
# not include lib/syscalls_linux_common.cyr, so the socket family,
# ioctl and fstatat have no wrapper there, and statfs / lstat take an
# explicit path length. The `_yk_*` bridges below keep yukti's
# Linux-only modules (optical / storage / network / udev) COMPILING on
# agnos. The rule, per bridge:
#
#   - agnos has the real syscall: call through to it (mkdir, statfs,
#     lstat).
#   - agnos lacks the call, or only has a stub that returns 0: fail
#     closed with -ENOSYS (mount, umount2, the socket family, ioctl,
#     ppoll). Fabricating success is the one outcome never acceptable.
#
# Before 2.3.12 the fail-closed half was a band of fake `SYS_*`
# numbers (9001-9010) handed to raw `syscall()`. That band is retired.
# Its statfs stub (9009) shadowed agnos's real statfs number, 103
# (6.6.6 warns on that too), and "an unknown syscall number fails" was
# an assumption about the kernel rather than code yukti owns.

# x86_64 ppoll. Neither Linux peer wraps ppoll, and only the aarch64
# peer names it, as 1073: a private alias that ESYSXLAT routes to
# aarch64's native 73. Native 73 cannot be issued directly
# on aarch64, because the x86-compat `flock 73 -> 32` row claims it.
# So x86_64 is the one target that needs a local number. Guarded
# `#ifndef CYRIUS_TARGET_AGNOS` because an agnos build also defines
# CYRIUS_ARCH_X86. See `_yk_ppoll` at the end of this file.
#ifndef CYRIUS_TARGET_AGNOS
#ifdef CYRIUS_ARCH_X86
enum YkSyscalls {
    SYS_PPOLL = 271;
}
#endif
#endif

# yukti-private open(2) flags (2.3.13), for the device opens in optical,
# storage, partition and audio. Every enum member and top-level `var` is a
# program-wide global, and the last definition wins. Until 2.3.12,
# `enum EjectConst` in src/storage.cyr declared plain `O_RDONLY = 0` and
# `O_NONBLOCK = 2048`, which redefined the stdlib peers' names for every
# program that included yukti:
#
#   - Darwin: O_NONBLOCK is 4, and 2048 is Darwin's O_EXCL, so a Mach-O
#     build turned every O_NONBLOCK in the program into O_EXCL.
#   - Windows and agnos: the peers declare no O_NONBLOCK, so yukti quietly
#     supplied one to other libraries (vani on Windows).
#
# The underscore-prefixed names stay inside yukti. The values follow the
# target: Darwin 4, and the Linux value (2048, the same on x86_64 and
# aarch64) everywhere else, which is what every target received before.
#ifdef CYRIUS_TARGET_MACOS
enum YkOpenFlag {
    _YK_O_RDONLY = 0;
    _YK_O_NONBLOCK = 4;
}
#endif
#ifndef CYRIUS_TARGET_MACOS
enum YkOpenFlag {
    _YK_O_RDONLY = 0;
    _YK_O_NONBLOCK = 2048;
}
#endif

# ---------------------------------------------------------------------------
# _yk_starts_with_cstr — prefix test against a C STRING (yukti 2.3.5)
#
# The stdlib's `str_starts_with(s: Str, prefix: Str)` takes a **Str** prefix.
# It has cstr peers for equality (`str_eq_cstr`), containment
# (`str_contains_cstr`) and indexing (`str_index_of_cstr`) — but NOT for
# prefix, so the obvious-looking `str_starts_with(s, "foo")` compiles and is
# silently wrong: the cstr pointer is read as a Str struct, so `str_len` and
# `str_data` return whatever bytes happen to follow it.
#
# The result is UNDEFINED, not merely false. Measured on 6.5.29: with a
# rodata literal the call returned 0 for every input, while with a
# `str_cstr()` result it returned 1 for every input. Both are wrong; which
# one you get depends on adjacent memory.
#
# All six yukti call sites had this bug before 2.3.5 (udev partition
# filtering, udevadm P:/E: line parsing, SMB share detection, the
# /run/media/ rmdir guard, and optical-device detection in eject).
#
# Lives here because src/syscalls.cyr is first in the include chain, so
# every later domain module can see it. Internal (`_yk_` prefix, not `pub`)
# — this repairs behaviour, it does not add public surface. It also replaces
# the unprefixed `str_starts_with_cstr` that src/audio.cyr had defined,
# which would have collided the moment the stdlib gained that name.
# ---------------------------------------------------------------------------

fn _yk_starts_with_cstr(s, prefix_cstr): bool {
    if (s == 0) { return false; }
    if (prefix_cstr == 0) { return false; }
    var plen = strlen(prefix_cstr);
    if (plen > str_len(s)) { return false; }
    var sd = str_data(s);
    for (var i = 0; i < plen; i = i + 1) {
        if (load8(sd + i) != load8(prefix_cstr + i)) { return false; }
    }
    return true;
}

# ---------------------------------------------------------------------------
# mount bridge (yukti 2.3.0)
# ---------------------------------------------------------------------------
# `sys_mount` is the one Linux-only syscall whose AGNOS wrapper is not merely a
# different arity — it is a 0-parameter NO-OP STUB that returns 0:
#
#     lib/syscalls_x86_64_agnos.cyr:  fn sys_mount(): i64 { return syscall(SYS_MOUNT); }
#
# So `sys_mount(src, tgt, fs, flags, data)` on agnos discarded all five arguments
# and returned success. yukti read that 0 as "mounted" and returned
# `Ok(mount_result_new(...))` for a mount that never happened — at three sites
# (storage.cyr x2, network.cyr x1). It went unnoticed because an arity mismatch was
# only a WARNING until cyrius 6.5.1 made it an error.
#
# This bridge keeps the Linux-only modules COMPILING on agnos while making the call
# FAIL CLOSED there, per the rule at the top of this file. Fabricating success is the
# one outcome that is never acceptable: every caller downstream then believes it has a
# mounted filesystem.
#
# NOT "fixed" by giving agnos a real 5-arg sys_mount: that is an agnos-side kernel ABI
# commitment, not yukti's call to make. If agnos later gains real mount support, delete
# the agnos branch here and nothing else changes.
var YK_ENOSYS = 38;   # ENOSYS — "function not implemented"

# Mount `source` at `target`. POSIX passes through to the kernel; agnos fails closed
# with -ENOSYS (see above). Callers already treat a negative return as errno.
fn _yk_mount(source, target, fstype, flags, data): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - YK_ENOSYS;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return sys_mount(source, target, fstype, flags, data);
    #endif
}

# ---------------------------------------------------------------------------
# umount bridge (yukti 2.3.1)
# ---------------------------------------------------------------------------
# The symmetric counterpart to `_yk_mount`, missed by the 2.3.0 sweep. Unlike the
# cases above this is not an ABI *mismatch* — `sys_umount2` does not exist on
# agnos AT ALL. It is defined only in lib/syscalls_linux_common.cyr, so an agnos
# build of storage.cyr emitted `warning: undefined function 'sys_umount2'` and
# produced a binary with an unresolved call in the unmount path.
#
# Note what agnos DOES offer, and why this bridge does not use it:
#
#     lib/syscalls_x86_64_agnos.cyr:  fn sys_umount(): i64 { ... }   # 0-arity STUB, returns 0
#
# Routing to that would re-introduce the exact defect `_yk_mount` exists to
# prevent — storage_unmount reads a 0 as "unmounted" and returns Ok(0) for a
# filesystem that is still mounted. Fabricating success is never acceptable, so
# agnos fails closed with -ENOSYS here, matching the mount side.
fn _yk_umount2(target, flags): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - YK_ENOSYS;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return sys_umount2(target, flags);
    #endif
}

# ---------------------------------------------------------------------------
# mkdir — no bridge since 2.3.12
# ---------------------------------------------------------------------------
# `_yk_mkdir` (2.3.1) existed because agnos's `sys_mkdir` is (path, pathlen) and
# POSIX's is (path, mode), at the SAME arity, so the mismatch drew no compiler
# diagnostic and the 0755 bound to `pathlen` on agnos. lib/io.cyr's `xmkdir`
# (cyrius 6.5.7) now does exactly what that bridge did: it computes the length
# on agnos, where the mode is necessarily dropped, and passes through elsewhere.
# The two call sites (storage.cyr, network.cyr) call `xmkdir` directly.

# ---------------------------------------------------------------------------
# statfs bridge (yukti 2.3.12)
# ---------------------------------------------------------------------------
# `buf` must be STATFS_BUFSZ bytes. Read the fields through the stdlib's
# STATFS_* offsets and `statfs_bsize()`, never literal offsets: the record's
# layout differs per target. Linux is `sys_statfs(path, buf)`, new in 6.6.6.
# agnos makes its REAL statfs #103, which takes an explicit path length and
# fills a frozen 32-byte record. The stdlib publishes that record's offsets
# under the same STATFS_* names. This replaces the 9009 fail-closed stub, which
# shadowed the real number.
fn _yk_statfs(path, buf): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return sys_statfs(path, strlen(path), buf);
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return sys_statfs(path, buf);
    #endif
}

# ---------------------------------------------------------------------------
# lstat bridge (yukti 2.3.12)
# ---------------------------------------------------------------------------
# stat that does NOT follow a trailing symlink, for storage_mount's TOCTOU
# guard. `buf` must be STAT_BUFSZ bytes; read st_mode through STAT_MODE.
#
# Linux issues newfstatat(AT_FDCWD, path, buf, AT_SYMLINK_NOFOLLOW), the same
# syscall the guard has always made, so a seccomp allowlist that admitted it
# still does. It is now spelled with the stdlib wrapper and its per-target AT_*
# constants instead of 262 / -100 / 256.
#
# agnos makes its REAL lstat #102. It is length-carrying, and its st_mode
# (STAT_MODE = 0) carries the POSIX type bits the guard tests. This replaces
# the 9010 fail-closed stub.
fn _yk_lstat(path, buf): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return sys_lstat(path, strlen(path), buf);
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return sys_fstatat(AT_FDCWD, path, buf, AT_SYMLINK_NOFOLLOW);
    #endif
}

# ---------------------------------------------------------------------------
# ioctl + socket-family bridges (yukti 2.3.12)
# ---------------------------------------------------------------------------
# agnos has no ioctl and no BSD-socket surface, and its stdlib peer defines
# none of these wrappers, so each one fails closed there. The callers are the
# optical, eject, netlink-monitor and network-probe paths. agnos never reaches
# them at runtime: vani, the sole agnos consumer, drives only `yukti_audio_*`.
# Each Linux arm is the stdlib wrapper with the same arguments, so it issues
# the same syscall the raw `syscall(SYS_*, …)` call did.
fn _yk_ioctl(fd, request, argp): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - YK_ENOSYS;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return sys_ioctl(fd, request, argp);
    #endif
}

fn _yk_socket(domain, type, protocol): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - YK_ENOSYS;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return sys_socket(domain, type, protocol);
    #endif
}

fn _yk_bind(fd, addr, addrlen): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - YK_ENOSYS;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return sys_bind(fd, addr, addrlen);
    #endif
}

fn _yk_connect(fd, addr, addrlen): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - YK_ENOSYS;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return sys_connect(fd, addr, addrlen);
    #endif
}

fn _yk_setsockopt(fd, level, optname, val, vallen): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - YK_ENOSYS;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return sys_setsockopt(fd, level, optname, val, vallen);
    #endif
}

fn _yk_recvfrom(fd, buf, len, flags, srcaddr, srcaddrlen): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - YK_ENOSYS;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return sys_recvfrom(fd, buf, len, flags, srcaddr, srcaddrlen);
    #endif
}

# ---------------------------------------------------------------------------
# ppoll bridge (yukti 2.3.12): the one raw syscall in yukti
# ---------------------------------------------------------------------------
# No stdlib peer wraps ppoll, so this is the one place yukti spells `syscall()`
# itself, and CI allows it here and nowhere else. aarch64 has no poll(2), only
# ppoll, so both Linux arches use ppoll. SYS_PPOLL is the local 271 on x86_64
# and the stdlib's 1073 alias on aarch64 (top of this file). `tsp` is a
# struct timespec*, or 0 to block indefinitely; the signal mask is NULL with
# sigsetsize 8. Switch to the stdlib wrapper once one exists (see roadmap.md).
#
# 2.3.14: macOS declines with Darwin's -ENOSYS (78), like agnos. Darwin has no
# ppoll, and neither Mach-O backend routes the number (271 on x86_64, 1073 on
# arm64), so every Mach-O build that included yukti warned "syscall N not
# routed". Reached, the call was a SIGSYS kill on Intel and, before cyrius
# 6.6.8, a silent re-run of the previous syscall on Apple Silicon. The only
# caller is the udev netlink monitor, which is Linux-only anyway. The number
# must not be COMPILED on macOS at all, so the Linux arm is `#ifndef`-guarded
# too, not just preceded by an early return.
fn _yk_ppoll(fds, nfds, tsp): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - YK_ENOSYS;
    #endif
    #ifdef CYRIUS_TARGET_MACOS
    return 0 - 78;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    #ifndef CYRIUS_TARGET_MACOS
    return syscall(SYS_PPOLL, fds, nfds, tsp, 0, 8);
    #endif
    #endif
}
