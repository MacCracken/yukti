# yukti/syscalls.cyr — arch-conditional SYS_* constants + shims for
# syscalls that lib/syscalls_{x86_64,aarch64}_linux.cyr doesn't expose.
#
# Centralises the arch divergence so the rest of yukti src/ can call
# `syscall(SYS_NAME, ...)` portably and the value resolves correctly
# at compile time per `CYRIUS_ARCH_*`. Mirrors the
# `lib/syscalls.cyr` dispatch pattern.
#
# Scope: socket family (socket / bind / connect / setsockopt /
# recvfrom / ppoll) and filesystem (statfs / newfstatat). Items live
# here and not in the upstream stdlib because they haven't been
# promoted yet — track in
# `docs/development/issues/2026-04-19-cc5-aarch64-repro.md`.
# clock_gettime was removed here at 2.2.6 — timestamps now go through
# stdlib `chrono.clock_epoch_secs()`, which routes correctly on
# macOS/Windows (a `var` syscall NUMBER does not trigger the macho/PE
# reroute — cyrius issue 2026-06-16-var-syscall-number-defeats-macho-pe-reroute).

# The `#ifndef CYRIUS_TARGET_AGNOS` is load-bearing, not belt-and-braces:
# agnos IS an x86_64 target, so cycc defines CYRIUS_ARCH_X86 *and*
# CYRIUS_TARGET_AGNOS on an agnos build. Without this guard, this block and the
# YkSyscallsAgnos block below both emit, redefining 8 names (SYS_SOCKET,
# SYS_CONNECT, SYS_BIND, SYS_RECVFROM, SYS_SETSOCKOPT, SYS_PPOLL, SYS_STATFS,
# SYS_NEWFSTATAT) with conflicting values. cyrius resolves that as "last
# definition wins", so the fail-closed 9001+ stubs won only because they happen
# to sit textually lower in this file — reordering the two blocks would have
# silently substituted real Linux syscall numbers into agnos builds, which is
# precisely what the stub band exists to prevent. Guard it; don't trust order.
#ifndef CYRIUS_TARGET_AGNOS
#ifdef CYRIUS_ARCH_X86
enum YkSyscalls {
    SYS_SOCKET = 41;
    SYS_CONNECT = 42;
    SYS_BIND = 49;
    SYS_RECVFROM = 45;
    SYS_SETSOCKOPT = 54;
    SYS_PPOLL = 271;
    SYS_STATFS = 137;
    SYS_NEWFSTATAT = 262;
}
#endif
#endif

#ifdef CYRIUS_ARCH_AARCH64
enum YkSyscalls {
    SYS_SOCKET = 198;
    SYS_CONNECT = 203;
    SYS_BIND = 200;
    SYS_RECVFROM = 207;
    SYS_SETSOCKOPT = 208;
    SYS_STATFS = 43;
}
# Stdlib aarch64 already defines SYS_PPOLL = 73 and SYS_NEWFSTATAT = 262 — the
# latter is the x86 number on purpose: cyrius's ESYSXLAT renumbers 262 → 79 at
# emit time (identical arg layouts, collision-free). Do not redefine either.
#endif

# AGNOS has no ioctl / BSD-socket / statfs / poll surface. These constants
# exist ONLY so the Linux-only enumerator modules (optical / storage /
# network / device) COMPILE on the agnos target — those code paths are never
# reached at runtime, because the sole agnos consumer (vani) drives only the
# `yukti_audio_*` path, which has its own agnos branch (audio.cyr). agnos also
# already defines SYS_LSEEK/STAT/UNLINK/RMDIR/MOUNT/MKDIR/UMOUNT in its stdlib
# (do NOT redefine those). The stub numbers sit in a high, deliberately-invalid
# band so an accidental call fails closed (unknown syscall → error) rather than
# aliasing a real low-numbered agnos syscall (e.g. Linux ioctl=16 == agnos kill).
#ifdef CYRIUS_TARGET_AGNOS
enum YkSyscallsAgnos {
    SYS_IOCTL = 9001;
    SYS_SOCKET = 9002;
    SYS_CONNECT = 9003;
    SYS_BIND = 9004;
    SYS_RECVFROM = 9005;
    SYS_SETSOCKOPT = 9006;
    SYS_PPOLL = 9007;
    SYS_POLL = 9008;
    SYS_STATFS = 9009;
    SYS_NEWFSTATAT = 9010;
}
#endif

# ---------------------------------------------------------------------------
# _yk_starts_with_cstr — prefix test against a C STRING (yukti 2.3.5)
#
# The stdlib's `str_starts_with(s: Str, prefix: Str)` takes a **Str** prefix.
# It has cstr peers for equality (`str_eq_cstr`), containment
# (`str_contains_cstr`) and indexing (`str_index_of_cstr`) — but NOT for
# prefix, so the obvious-looking `str_starts_with(s, "foo")` compiles and is
# silently wrong: the cstr pointer is read as a Str struct, so `str_len` and
# `str_data` return whatever bytes happen to follow it.
#
# The result is UNDEFINED, not merely false. Measured on 6.5.29: with a
# rodata literal the call returned 0 for every input, while with a
# `str_cstr()` result it returned 1 for every input. Both are wrong; which
# one you get depends on adjacent memory.
#
# All six yukti call sites had this bug before 2.3.5 (udev partition
# filtering, udevadm P:/E: line parsing, SMB share detection, the
# /run/media/ rmdir guard, and optical-device detection in eject).
#
# Lives here because src/syscalls.cyr is first in the include chain, so
# every later domain module can see it. Internal (`_yk_` prefix, not `pub`)
# — this repairs behaviour, it does not add public surface. It also replaces
# the unprefixed `str_starts_with_cstr` that src/audio.cyr had defined,
# which would have collided the moment the stdlib gained that name.
# ---------------------------------------------------------------------------

fn _yk_starts_with_cstr(s, prefix_cstr): i64 {
    if (s == 0) { return 0; }
    if (prefix_cstr == 0) { return 0; }
    var plen = strlen(prefix_cstr);
    if (plen > str_len(s)) { return 0; }
    var sd = str_data(s);
    for (var i = 0; i < plen; i = i + 1) {
        if (load8(sd + i) != load8(prefix_cstr + i)) { return 0; }
    }
    return 1;
}

# ---------------------------------------------------------------------------
# mount bridge (yukti 2.3.0)
# ---------------------------------------------------------------------------
# `sys_mount` is the one Linux-only syscall whose AGNOS wrapper is not merely a
# different arity — it is a 0-parameter NO-OP STUB that returns 0:
#
#     lib/syscalls_x86_64_agnos.cyr:  fn sys_mount(): i64 { return syscall(SYS_MOUNT); }
#
# So `sys_mount(src, tgt, fs, flags, data)` on agnos discarded all five arguments
# and returned success. yukti read that 0 as "mounted" and returned
# `Ok(mount_result_new(...))` for a mount that never happened — at three sites
# (storage.cyr x2, network.cyr x1). It went unnoticed because an arity mismatch was
# only a WARNING until cyrius 6.5.1 made it an error.
#
# This bridge keeps the Linux-only modules COMPILING on agnos — the same reason the
# 9001+ stub numbers above exist — while making the call FAIL CLOSED there, which is
# the stated philosophy of that block. Fabricating success is the one outcome that is
# never acceptable: every caller downstream then believes it has a mounted filesystem.
#
# NOT "fixed" by giving agnos a real 5-arg sys_mount: that is an agnos-side kernel ABI
# commitment, not yukti's call to make. If agnos later gains real mount support, delete
# the agnos branch here and nothing else changes.
var YK_ENOSYS = 38;   # ENOSYS — "function not implemented"

# Mount `source` at `target`. POSIX passes through to the kernel; agnos fails closed
# with -ENOSYS (see above). Callers already treat a negative return as errno.
fn _yk_mount(source, target, fstype, flags, data): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - YK_ENOSYS;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return sys_mount(source, target, fstype, flags, data);
    #endif
}

# ---------------------------------------------------------------------------
# umount bridge (yukti 2.3.1)
# ---------------------------------------------------------------------------
# The symmetric counterpart to `_yk_mount`, missed by the 2.3.0 sweep. Unlike the
# cases above this is not an ABI *mismatch* — `sys_umount2` does not exist on
# agnos AT ALL. It is defined only in lib/syscalls_linux_common.cyr, so an agnos
# build of storage.cyr emitted `warning: undefined function 'sys_umount2'` and
# produced a binary with an unresolved call in the unmount path.
#
# Note what agnos DOES offer, and why this bridge does not use it:
#
#     lib/syscalls_x86_64_agnos.cyr:  fn sys_umount(): i64 { ... }   # 0-arity STUB, returns 0
#
# Routing to that would re-introduce the exact defect `_yk_mount` exists to
# prevent — storage_unmount reads a 0 as "unmounted" and returns Ok(0) for a
# filesystem that is still mounted. Fabricating success is never acceptable, so
# agnos fails closed with -ENOSYS here, matching the mount side.
fn _yk_umount2(target, flags): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - YK_ENOSYS;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return sys_umount2(target, flags);
    #endif
}

# ---------------------------------------------------------------------------
# mkdir bridge (yukti 2.3.1)
# ---------------------------------------------------------------------------
# `sys_mkdir` is LENGTH-carrying on agnos and MODE-carrying on POSIX, at the
# SAME 2-arity — so the mismatch produces no compiler diagnostic. That is how it
# survived the 2.3.0 sweep of this exact bug class, which only caught the sites
# where the arity also differed:
#
#     lib/syscalls_x86_64_agnos.cyr:   fn sys_mkdir(path, pathlen)
#     lib/syscalls_x86_64_linux.cyr:   fn sys_mkdir(path, mode)
#     lib/syscalls_aarch64_linux.cyr:  fn sys_mkdir(path, mode)   # via mkdirat
#
# yukti called `sys_mkdir(path, 493)` (0755) at two sites (storage.cyr and
# network.cyr). On agnos the 493 bound to `pathlen`, so the kernel was told
# to read 493 bytes from a path whose string is far shorter — an over-read past
# the NUL into whatever trailing bytes followed the buffer.
#
# Unlike `sys_mount` above, agnos's `sys_mkdir` is a REAL syscall, not a no-op
# stub, so this bridge calls THROUGH correctly instead of failing closed. That
# mirrors the stdlib's own `xrmdir` (lib/io.cyr), which resolves the identical
# length-vs-pointer split for the sibling rmdir call, and which storage.cyr
# already uses.
#
# `mode` is necessarily dropped on agnos: its mkdir ABI carries no mode
# argument. Callers wanting a specific mode there must chmod separately.
fn _yk_mkdir(path, mode): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return sys_mkdir(path, strlen(path));
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return sys_mkdir(path, mode);
    #endif
}
